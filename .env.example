# Provedor do Modelo: "gemini", "openai", "groq", "ollama", ou "mock" (para testes sem API)
LLM_PROVIDER=gemini

# Modelo a ser utilizado
# Gemini: gemini-2.5-flash ou gemini-1.5-flash
# OpenAI: gpt-4o-mini ou gpt-4o
# Groq: llama-3.3-70b-versatile
LLM_MODEL=gemini-2.5-flash

# Chaves de API (preencha a do provedor escolhido)
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=sua_chave_openai_aqui
GROQ_API_KEY=sua_chave_groq_aqui

# Configuração Ollama (se LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Caminhos de dados
DATABASE_PATH=data/emporio.db
DATA_DIR=data
POLICIES_FILE=data/policies.json

